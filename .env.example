# SpecMatch — environment template
# Copy to .env and fill values. All entries are optional for local SQLite dev.

# Database (default: sqlite at backend/specmatch.db)
# For Postgres + pgvector:
# DATABASE_URL=postgresql+psycopg://specmatch:specmatch@localhost:5432/specmatch
DATABASE_URL=sqlite:///backend/specmatch.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///backend/specmatch.db

# API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true
API_PREFIX=/api

# Search / retrieval
SEARCH_PAGE_SIZE=20
SEARCH_MAX_PAGE_SIZE=100
FTS_TOKENIZER=porter unicode61
TOP_K_CANDIDATES=50
TOP_K_RECOMMENDATIONS=5

# Uploads
MAX_UPLOAD_SIZE_MB=10

# Embeddings / reranker / LLM (Phase 3 — leave blank for FTS-only)
# EMBEDDING_PROVIDER=openai|cohere|local
# EMBEDDING_API_KEY=
# VECTOR_DIMENSION=384
# RERANKER_PROVIDER=cohere|local
# LLM_PROVIDER=openai|anthropic
# LLM_API_KEY=

# OpenRouter LLM (Phase 5 — evidence-grounded intelligence)
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TEMPERATURE=0.3

# Dataset version
DATASET_VERSION=V0.3
STANDARDS_COUNT=24,132
